generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  phone         String?
  dateOfBirth   DateTime?
  nationality   String?
  loyaltyNumber String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  

  preferences   UserPreferences?
  role          UserRole  @default(GUEST)

  // Messaging & Notifications
  messages      Message[]
  conversations ConversationParticipant[]
  notifications Notification[]
}

enum UserRole {
  GUEST
  ADMIN
  STAFF
}

model UserPreferences {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id])
  
  preferredLanguage String  @default("en")
  floorPreference   String? // "high", "low", "middle"
  roomViewPref      String? // "city", "ocean", "garden"
  bedTypePreference String? // "king", "twin", "queen"
  
  marketingEmails   Boolean @default(false)
  marketingSMS      Boolean @default(false)
  theme             String  @default("light") // "light", "dark", "system"
}

model Apartment {
  id            String   @id @default(cuid())
  sanityId      String   @unique
  name          String
  slug          String   @unique
  description   String?
  basePrice     Float
  capacity      Int
  size          Int?
  image         String?
  location      String?
  features      String[]
  isActive      Boolean  @default(true)
  
  // New Status & Maintenance fields
  status        RoomStatus @default(AVAILABLE)
  assignedStaffId String?
  
  // Booking constraints
  minNights     Int      @default(1)
  maxNights     Int      @default(30)
  bookingBuffer Int      @default(0)
  
  bookings      Booking[]
  availability  ApartmentAvailability[]
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  TO_CLEAN
  OUT_OF_SERVICE
  REPAIR
}

model Conversation {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime  @default(now())
  
  participants  ConversationParticipant[]
  messages      Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  
  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  createdAt      DateTime     @default(now())
  read           Boolean      @default(false)
}

model ApartmentAvailability {
  id          String    @id @default(cuid())
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id])
  startDate   DateTime
  endDate     DateTime
  type        String    // "BLOCKED", "MAINTENANCE", etc.
  reason      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([apartmentId])
  @@index([startDate, endDate])
}

model Booking {
  id                    String    @id @default(cuid())
  confirmationNumber    String    @unique @default(cuid())
  bookingAccessToken    String?   @unique // For guests to view/manage booking
  
  // Property & Dates
  apartmentId           String
  apartment             Apartment @relation(fields: [apartmentId], references: [id])
  checkInDate           DateTime
  checkOutDate          DateTime
  numberOfNights        Int
  
  // Guest Details
  guestFirstName        String
  guestLastName         String
  guestEmail            String
  guestPhone            String
  guestDateOfBirth      DateTime?
  guestNationality      String?
  guestPassportId       String?    // ID or Passport number
  
  // Guest Address
  address               String
  city                  String
  zipCode               String
  country               String
  
  // Occupancy
  adults                Int       @default(1)
  children              Int       @default(0)
  infantsUnder2         Int       @default(0)
  
  // Emergency Contact
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyRelationship String?
  
  // Arrival Information
  estimatedArrivalTime  String?   // "14:00", "After 18:00"
  flightNumber          String?   // If applicable
  earlyCheckInRequest   Boolean   @default(false)
  lateCheckOutRequest   Boolean   @default(false)
  
  // Room Preferences
  floorPreference       String?   // "high", "low", "no-preference"
  viewPreference        String?   // "city", "garden", "ocean", "no-preference"
  bedTypePreference     String?   // "king", "twin", "queen"
  smokingRoom           Boolean   @default(false)
  accessibleRoom        Boolean   @default(false)
  
  // Additional Services
  airportTransferNeeded Boolean   @default(false)
  transferPickupTime    String?
  transferDropoffTime   String?
  
  parkingRequired       Boolean   @default(false)
  numberOfVehicles      Int       @default(0)
  
  breakfastIncluded     Boolean   @default(false)
  breakfastGuests       Int       @default(0)
  
  extraBedRequested     Boolean   @default(false)
  cribRequested         Boolean   @default(false)
  
  // Special Requests & Notes
  specialRequests       String?
  dietaryRestrictions   String?
  purposeOfStay         String?   // "leisure", "business", "celebration"
  celebrationDetails    String?   // If it's birthday/anniversary
  
  // Payment Information
  paymentMethod         String    // "credit-card", "pay-at-property"
  cardName              String?
  cardLastFour          String?
  cardExpiry            String?
  
  // Pricing Breakdown
  basePrice             Float
  numberOfNightsCounted Int
  subtotal              Float     // basePrice * nights
  cleaningFee           Float     @default(50)
  serviceFee            Float     @default(30)
  taxRate               Float     @default(0.10) // 10%
  taxAmount             Float
  totalPrice            Float
  
  depositRequired       Float     @default(0)
  depositPaid           Float     @default(0)
  
  currency              String    @default("USD")
  
  // Legal Acknowledgments
  termsAccepted         Boolean   @default(false)
  termsAcceptedAt       DateTime?
  cancellationPolicyAccepted Boolean @default(false)
  ageVerified           Boolean   @default(false) // Confirmed 18+
  
  // Communication Preferences
  preferredLanguage     String    @default("en")
  sendEmailConfirmation Boolean   @default(true)
  sendSMSConfirmation   Boolean   @default(false)
  marketingOptIn        Boolean   @default(false)
  
  // Booking Status & Management
  status                BookingStatus @default(PENDING)
  paymentStatus         PaymentStatus @default(PENDING)
  bookingSource         String    @default("website")
  assignedRoomNumber    String?
  
  // Device & Meta
  cardBrand             String?
  ipAddress             String?
  userAgent             String?
  
  // Cancellation
  cancelledAt           DateTime?
  cancellationReason    String?
  refundAmount          Float     @default(0)
  cancellationFee       Float     @default(0)
  
  // Internal Notes (Staff Only)
  internalNotes         String?
  staffAssignedTo       String?
  
  // Timestamps
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  confirmedAt           DateTime?
  
  @@index([confirmationNumber])
  @@index([guestEmail])
  @@index([status])
  @@index([checkInDate])
  @@index([bookingAccessToken])
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  userEmail String
  changes   Json?
  metadata  Json?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("info") // "info", "success", "warning", "error"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum PaymentMethod {
  CREDIT_CARD
  PAY_AT_PROPERTY
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  REFUNDED
  FAILED
}